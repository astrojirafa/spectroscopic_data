   ],
   "source": [
    "norm_files = len(os.listdir(output_folder))\n",
    "print(f'Hay {norm_files} archivos en la carpeta {output_folder}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "PsiwXt_QEKLd",
    "outputId": "c0f81a3f-7f71-4df0-dde9-d6bbc5eb5181"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Se encontraron 121 identificadores. Procediendo a guardar el archivo.\n",
      "Archivo fits con identificadores guardado en: /drive/My Drive/Data/identifier/identifiers.fits\n"
     ]
    }
   ],
   "source": [
    "#definir la carpeta donde se guardará el archivo de identificadores\n",
    "identifiers_folder = '/drive/My Drive/Data/identifier/'\n",
    "\n",
    "#crear la carpeta si no existe\n",
    "os.makedirs(identifiers_folder, exist_ok=True)\n",
    "\n",
    "#verificar si identifiers tiene datos antes de convertirlo a array de numpy\n",
    "if len(identifiers) > 0:\n",
    "    print(f'Se encontraron {len(identifiers)} identificadores. Procediendo a guardar el archivo.')\n",
    "\n",
    "    #convertir a array NumPy correctamente\n",
    "    identifiers_array = np.array(identifiers, dtype=np.int32)\n",
    "\n",
    "    #crear las columnas del archivo FITS\n",
    "    col_defs = [\n",
    "        fits.Column(name='plate', format='J', array=identifiers_array[:, 0]),\n",
    "        fits.Column(name='mjd', format='J', array=identifiers_array[:, 1]),\n",
    "        fits.Column(name='fiberid', format='J', array=identifiers_array[:, 2])\n",
    "    ]\n",
    "\n",
    "    #crear la tabla FITS\n",
    "    hdu = fits.BinTableHDU.from_columns(col_defs)\n",
    "\n",
    "    #definir la ruta del archivo\n",
    "    output_id_file = os.path.join(identifiers_folder, 'identifiers.fits')\n",
    "\n",
    "    #guardar el archivo\n",
    "    try:\n",
    "        hdu.writeto(output_id_file, overwrite=True)\n",
    "        print(f'Archivo fits con identificadores guardado en: {output_id_file}')\n",
    "    except Exception as e:\n",
    "        print(f'Error al guardar el archivo FITS: {e}')\n",
    "        raise\n",
    "else:\n",
    "    print('No hay identificadores para guardar.')"
   ]
  }
