   "source": [
    "### Normalización de los espectros"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "zsEc_D0NK9UL"
   },
   "source": [
    "Este código normaliza los espectros luego de haber sido filtrados por sus longitudes de onda comunes y curados previamente. Al final del mismo, crea un archivo con los identificadores (MJD, FIBERID, PLATE) que se utilizará luego para realizar la normalización de los datos fotométricos.\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "WJ6_cOp4B1D9"
   },
   "outputs": [],
   "source": [
    "from astropy.io import fits\n",
    "import numpy as np\n",
    "import os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "7U8CGitX6qWy",
    "outputId": "78b6c591-16ff-425e-d6d5-b5b3e6390aad"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mounted at /drive\n"
     ]
    }
   ],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "qpIWQFlMCENv"
   },
   "outputs": [],
   "source": [
    "#cargar los espectros\n",
    "spec_path = '/drive/My Drive/Data/spec_data/final_spec/'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "dhTmCVdMGKx9"
   },
   "outputs": [],
   "source": [
    "#carpeta donde se guardan los espectros normalizados\n",
    "output_folder = '/drive/My Drive/Data/spec_data/spec_normalizados/'\n",
    "\n",
    "#crear la carpeta en caso de que no exista\n",
    "if not os.path.exists(output_folder):\n",
    "    os.makedirs(output_folder)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "EV12_RfpC7Zj"
   },
   "outputs": [],
   "source": [
    "#guardar todos los espectros en la variable spec_files\n",
    "all_files = os.listdir(spec_path)\n",
    "\n",
    "spec_files = []\n",
    "for file in all_files:\n",
    "    if file.endswith('.fits'):\n",
    "        spec_files.append(file)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "v9dpzbSQDtjp"
   },
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "#lista para almacenar los identificadores de todos los archivos normalizados\n",
    "identifiers = []\n",
    "\n",
    "#normalizar cada espectro:\n",
    "for fits_file in spec_files:\n",
    "\n",
    "    #ruta a los espectros a normalizar\n",
    "    file_path = os.path.join(spec_path, fits_file)\n",
    "\n",
    "    #abrir el espectro\n",
    "    with fits.open(file_path) as hdul:\n",
    "        # acceder a los datos del espectro, que están en la segunda extensión (indice 1)\n",
    "        data = hdul[1].data\n",
    "        flux_data = data['flux']\n",
    "\n",
    "        #asegurarse de que flux_data sea un arreglo unidimensional\n",
    "        flux_data = np.ravel(flux_data)\n",
    "\n",
    "        #verificar los valores de flujo antes de la normalización (los primeros 10)\n",
    "        #print(f\"Valores de flujo antes de normalizar: {flux_data[:10]}...\")\n",
    "\n",
    "        #calculo de la norma del espectro\n",
    "        norm = np.sqrt(np.sum(flux_data**2))\n",
    "\n",
    "        #NORMALIZAR EL ESPECTRO\n",
    "        if norm != 0:\n",
    "            normalized_flux = flux_data / norm\n",
    "        else:\n",
    "            print(f\"Espectro con norma cero descartado: {fits_file}\")\n",
    "            continue #si tiene norma cero, no se lo procesa\n",
    "\n",
    "        #mostrar los valores normalizados para verificar\n",
    "        #print(f\"Valores de flujo normalizados: {normalized_flux[:10]}...\")\n",
    "\n",
    "        #crear las columnas nuevas para el archivo del espectro normalizado:\n",
    "        #conserva las otras columnas que no son flux\n",
    "        new_columns = []\n",
    "        for col in hdul[1].columns:\n",
    "            if col.name != 'flux':\n",
    "                new_columns.append(col)\n",
    "\n",
    "        #agregar la nueva columna 'flux' de los espectros normalizados\n",
    "        new_columns.append(fits.Column(name='flux', format='D', array=normalized_flux))  #fits.column, agrega la columna. format = D, le da formato float a los objetos de esa columna\n",
    "\n",
    "        #crear un nuevo hdu (archivo fits con las columnas modificadas)\n",
    "        new_hdu = fits.BinTableHDU.from_columns(new_columns)\n",
    "\n",
    "        #cambiar el nombre del archivo\n",
    "        new_name = fits_file.replace('final_', '').replace('.fits', '_normalized.fits')\n",
    "\n",
    "        #guardarlos en la carpeta con el nombre nuevo\n",
    "        new_filename = os.path.join(output_folder, new_name)\n",
    "        #eliminar el archivo si ya existe para sobreescribirlo\n",
    "        if os.path.exists(new_filename):\n",
    "            os.remove(new_filename)\n",
    "\n",
    "        #guardar el archivo\n",
    "        new_hdu.writeto(new_filename)\n",
    "\n",
    "\n",
    "        #print(f\"Archivo FITS normalizado guardado en: {new_filename}\")\n",
    "\n",
    "        #extraer plate, mjd y fiberid y guardarlos en la lista identifiers\n",
    "        match = re.search(r'spec-(\\d+)-(\\d+)-(\\d+)_normalized.fits', new_name)\n",
    "        if match:\n",
    "            plate, mjd, fiberid = match.groups()\n",
    "            identifiers.append((plate, mjd, fiberid))  # Guardar en la lista\n",
    "        else:\n",
    "            print(f\"Formato inesperado en el archivo: {new_name}\")\n",
    "\n",
    "\n",
    "# Imprimir todos los identificadores extraídos\n",
    "#print(\'\\nLista de identificadores extraídos:\')\n",
    "#for plate, mjd, fiberid in identifiers:\n",
    "    #print(f\'Plate: {plate}, MJD: {mjd}, FiberID: {fiberid}\')"
   ]
  },
